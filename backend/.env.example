# --- App ---
PROJECT_NAME=TimeGen AI
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# --- Database (PostgreSQL) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=timegen
POSTGRES_PASSWORD=timegen
POSTGRES_DB=timegen_ai

# --- Bootstrap admin (created by seed script on first run) ---
FIRST_ADMIN_NAME=Yatharth Sharma
FIRST_ADMIN_EMAIL=admin@timegen.ai
FIRST_ADMIN_PASSWORD=change-this-password
